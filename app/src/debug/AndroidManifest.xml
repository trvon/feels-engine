<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the device loop trigger a rotation from adb without touching the UI.
     Guarded by DUMP, which only shell and system hold. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.RotateNowReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.fengine.wallpaper.ROTATE_NOW" />
                <action android:name="dev.fengine.wallpaper.PROBE" />
                <action android:name="dev.fengine.wallpaper.SEED" />
                <action android:name="dev.fengine.wallpaper.SCAN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
